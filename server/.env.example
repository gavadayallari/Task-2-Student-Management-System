# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/studenthub?retryWrites=true&w=majority
# For Local MongoDB: mongodb://127.0.0.1:27017/studenthub
MONGODB_URI=your_mongodb_connection_string_here

# Frontend Client URL (for CORS)
CLIENT_URL=https://your-frontend-domain.vercel.app
